# Copiare questo file in ".env" e valorizzare le variabili.
# Non committare mai il file ".env" reale (vedi .gitignore).

# URL pubblico del progetto Supabase (non è un segreto di per sé,
# ma va comunque tenuto fuori dal codice sorgente per poter variare
# facilmente tra ambienti dev / staging / prod)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Chiave "anon" pubblica di Supabase.
# NB: questa chiave è pensata per essere esposta lato client SOLO se
# le policy di Row Level Security (RLS) sono correttamente configurate
# su ogni tabella. Non usare MAI la "service_role key" nel client mobile.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
