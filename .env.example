# Example environment variables for local development with Expo
# Copy this file to .env (which is gitignored) and fill the values.
# Then start Expo with: expo start -c

# Public Supabase URL (example: https://xyzabcd.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (safe to be public only if RLS is configured)
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enable local debug flags
# EXPO_PUBLIC_FEATURE_FLAG_X=true
